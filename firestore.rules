rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function userDocExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function userData() {
      return get(userPath(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userData().rol : null;
    }

    function hasRole(r) {
      return userRole() == r;
    }

    function isAdminCocina() {
      return hasRole('admin_cocina');
    }

    function isNutricion() {
      return hasRole('nutricion');
    }

    function isAdminDeposito() {
      return hasRole('admin_deposito');
    }

    function isControlComedor() {
      return hasRole('control_comedor');
    }

    function isAdministrativoCampamento() {
      return hasRole('administrativo_campamento');
    }

    function isAdministrativoFinanzas() {
      return hasRole('administrativo_finanzas');
    }

    function isAdministrativoLiquidaciones() {
      return hasRole('administrativo_liquidaciones');
    }

    function isAnalista() {
      return hasRole('analista');
    }

    function isGerencia() {
      return hasRole('gerencia');
    }

    /** Lectura transversal de datos operativos (sin silo por ubicación en la app). */
    function visionGlobalLectura() {
      return isAnalista() || isGerencia() || isAdministrativoFinanzas()
        || isAdministrativoLiquidaciones();
    }

    /** Panel `/control`: lectura operativa + finanzas (según rol). */
    function panelControlLectura() {
      return isAdministrativoCampamento() || isAdministrativoFinanzas()
        || isAdministrativoLiquidaciones()
        || isGerencia() || isAnalista();
    }

    /** Escritura operativa en `/control` (hotelería, padrón, comensales). */
    function panelControlEscritura() {
      return isAdministrativoCampamento();
    }

    /** Finanzas — lectura (Compras, Tesorería). */
    function finanzasLectura() {
      return isAdministrativoFinanzas() || isGerencia() || isAnalista();
    }

    /** Finanzas — escritura compras/pagos (sin liquidaciones). */
    function finanzasEscritura() {
      return isAdministrativoFinanzas();
    }

    /** Liquidaciones — lectura. */
    function liquidacionesLectura() {
      return isAdministrativoLiquidaciones() || isGerencia() || isAnalista();
    }

    /** Liquidaciones — escritura. */
    function liquidacionesEscritura() {
      return isAdministrativoLiquidaciones();
    }

    /** Proveedor de autenticación Firebase (p. ej. `anonymous`, `password`). */
    function authSignInProvider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    /** Vista pública de pedidos (`signInAnonymously` en `authPublico.ts`). */
    function isAuthAnonimo() {
      return signedIn() && authSignInProvider() == 'anonymous';
    }

    /**
     * Quien puede crear pedidos o descontar stock del menú en transacción:
     * cliente anónimo o terminal de comedor con documento en `usuarios`.
     */
    function isClientePedido() {
      return isAuthAnonimo() || isControlComedor();
    }

    function servicioComedorValido(s) {
      return s == 'DESAYUNO' || s == 'ALMUERZO' || s == 'MERIENDA' || s == 'CENA'
        || s == 'CENA_NOCHERO' || s == 'FUERA DE HORARIO';
    }

    /** Carga retroactiva desde dashboard: no admite fuera de horario. */
    function servicioComedorRetroManualValido(s) {
      return s == 'DESAYUNO' || s == 'ALMUERZO' || s == 'MERIENDA' || s == 'CENA' || s == 'CENA_NOCHERO';
    }

    function fechaHoraRegistroComedorOk() {
      return request.resource.data.fechaHora is timestamp
        || request.resource.data.fechaHora == request.time;
    }

    function contieneRefrigerioRegistroComedorOk() {
      return !request.resource.data.keys().hasAny(['contieneRefrigerio'])
        || request.resource.data.contieneRefrigerio is bool;
    }

    function observacionesRegistroComedorOpcionalOk() {
      return !request.resource.data.keys().hasAny(['observaciones'])
        || (
          request.resource.data.observaciones is string
          && request.resource.data.observaciones.size() > 0
          && request.resource.data.observaciones.size() <= 2000
        );
    }

    function creacionRegistroComedorTerminal() {
      return isControlComedor()
        && request.resource.data.keys().hasAll([
          'dni', 'nombre', 'apellido', 'empresa', 'servicio', 'diaOperativo', 'fechaHora', 'usuarioRegistro'
        ])
        && request.resource.data.dni is string
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string
        && request.resource.data.empresa is string
        && request.resource.data.diaOperativo is string
        && request.resource.data.diaOperativo.size() == 10
        && request.resource.data.usuarioRegistro is string
        && request.resource.data.usuarioRegistro == request.auth.uid
        && servicioComedorValido(request.resource.data.servicio)
        && fechaHoraRegistroComedorOk()
        && contieneRefrigerioRegistroComedorOk()
        && observacionesRegistroComedorOpcionalOk();
    }

    function creacionRegistroComedorSupervisor() {
      return panelControlEscritura()
        && request.resource.data.keys().hasAll([
          'dni', 'nombre', 'apellido', 'empresa', 'servicio', 'diaOperativo', 'fechaHora', 'usuarioRegistro',
          'observaciones'
        ])
        && request.resource.data.dni is string
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string
        && request.resource.data.empresa is string
        && request.resource.data.diaOperativo is string
        && request.resource.data.diaOperativo.size() == 10
        && request.resource.data.usuarioRegistro == 'Carga Manual Supervisor'
        && request.resource.data.observaciones is string
        && request.resource.data.observaciones.size() > 0
        && request.resource.data.observaciones.size() <= 2000
        && servicioComedorRetroManualValido(request.resource.data.servicio)
        && fechaHoraRegistroComedorOk()
        && contieneRefrigerioRegistroComedorOk();
    }

    /** Staff con documento en `usuarios` (excluye solo anónimos sin rol). */
    function staffLeerInsumos() {
      return isAdminDeposito() || isAnalista() || isGerencia()
        || isAdministrativoCampamento() || isAdministrativoFinanzas()
        || isAdministrativoLiquidaciones() || isAdminCocina() || isNutricion();
    }

    function puedeLeerMovimientos() {
      return isAdminDeposito() || isAnalista() || isGerencia()
        || isAdministrativoCampamento() || isAdministrativoFinanzas()
        || isAdministrativoLiquidaciones() || isAdminCocina();
    }

    /** Ubicación operativa del usuario campamento (fallback Casposo si no está en el doc). */
    function campamentoUbicacionUsuario() {
      return (userDocExists() &&
        userData().keys().hasAny(['ubicacionId']) &&
        userData().ubicacionId is string &&
        userData().ubicacionId != '')
        ? userData().ubicacionId
        : 'CASPOSO';
    }

    /** Campamento o jefe de campamento: solo documentos cuya ubicación coincide con la del usuario. */
    function campamentoUbicacionCoincide() {
      return isAdministrativoCampamento()
        && request.resource.data.keys().hasAny(['ubicacionId'])
        && request.resource.data.ubicacionId == campamentoUbicacionUsuario();
    }

    /** Ubicación cocina central (fallback COCINA si no está en el doc). */
    function cocinaUbicacionUsuario() {
      return (userDocExists() &&
        userData().keys().hasAny(['ubicacionId']) &&
        userData().ubicacionId is string &&
        userData().ubicacionId != '')
        ? userData().ubicacionId
        : 'COCINA';
    }

    /** Cocina: movimientos e ingresos solo en su ubicación operativa. */
    function cocinaUbicacionCoincide() {
      return isAdminCocina()
        && request.resource.data.keys().hasAny(['ubicacionId'])
        && request.resource.data.ubicacionId == cocinaUbicacionUsuario();
    }

    function puedeCrearMovimiento() {
      return isAdminDeposito() || campamentoUbicacionCoincide() || cocinaUbicacionCoincide();
    }

    function puedeEscribirSaldoLote() {
      return isAdminDeposito() || campamentoUbicacionCoincide() || cocinaUbicacionCoincide();
    }

    /** Devolución de stock al depósito cuando cocina/campamento rechaza un remito EN_TRANSITO. */
    function receptorRestauraSaldoDepositoEnRechazo() {
      return (isAdminCocina() || isAdministrativoCampamento())
        && request.resource.data.keys().hasAny(['ubicacionId'])
        && request.resource.data.ubicacionId == 'CENTRAL'
        && resource.data.keys().hasAny(['cantidad'])
        && request.resource.data.keys().hasAny(['cantidad'])
        && request.resource.data.cantidad is number
        && resource.data.cantidad is number
        && request.resource.data.cantidad > resource.data.cantidad;
    }

    /** Recepción en sucursal o cocina: cerrar egreso EN_TRANSITO destinado a esta ubicación. */
    function receptorPuedeCerrarRecepcionEgreso() {
      return resource.data.tipo == 'EGRESO'
        && resource.data.estadoTraslado == 'EN_TRANSITO'
        && resource.data.keys().hasAny(['ubicacionDestino'])
        && (
          (isAdministrativoCampamento() && resource.data.ubicacionDestino == campamentoUbicacionUsuario())
          || (isAdminCocina() && resource.data.ubicacionDestino == cocinaUbicacionUsuario())
        );
    }

    /** Pedido público (cliente anónimo o staff): creación con campos mínimos. */
    function pedidoClienteValido() {
      return request.resource.data.keys().hasAll(['nombreCliente', 'lugarEntrega'])
        && request.resource.data.nombreCliente is string
        && request.resource.data.lugarEntrega is string
        && (
          !request.resource.data.keys().hasAny(['fechaConsumo'])
          || request.resource.data.fechaConsumo is string
        );
    }

    /** Reserva de stock al confirmar pedido: solo sube `stockComprometido`. */
    function menuComprometeStockPedido() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['stockComprometido'])
        && request.resource.data.stockComprometido is int
        && request.resource.data.stockComprometido >= 0
        && request.resource.data.stockComprometido > resource.data.get('stockComprometido', 0);
    }

    /** Descuento de stock del menú: solo baja estricta de `stock` (legado). */
    function menuSoloDescuentaStock() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // ─── Módulo A: Compras (Procurement) ───────────────────────────────────

    /** Oficina de finanzas: crear/editar OC (sin aprobar). */
    function isComprador() {
      return isAdministrativoFinanzas();
    }

    function puedeLeerCompras() {
      return finanzasLectura() || isAdminDeposito();
    }

    function estadoOrdenCompraValido(s) {
      return s == 'BORRADOR' || s == 'PENDIENTE_APROBACION' || s == 'APROBADA'
        || s == 'RECIBIDA_PARCIAL' || s == 'COMPLETADA' || s == 'CANCELADA';
    }

    function creacionOrdenCompraValida() {
      return request.resource.data.keys().hasAll([
          'numero', 'anio', 'secuencial', 'estado', 'proveedorId',
          'proveedorNombre', 'proveedorCuit', 'ubicacionDestinoId',
          'fechaEmision', 'fechaEntregaEstimada', 'moneda', 'plazoPagoDias',
          'condicionPago', 'subtotalNeto', 'montoIva', 'montoPercepciones',
          'total', 'items', 'historialEstados', 'creadoPorUid', 'creadoPorNombre',
          'movimientosIngresoIds', 'recepcionCompleta'
        ])
        && request.resource.data.estado == 'APROBADA'
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.aprobadoPorUid == request.auth.uid
        && request.resource.data.recepcionCompleta == false
        && request.resource.data.movimientosIngresoIds.size() == 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && estadoOrdenCompraValido(request.resource.data.estado)
        && (
          !request.resource.data.keys().hasAny(['solicitudMercaderiaId'])
          || (
            request.resource.data.solicitudMercaderiaId is string
            && request.resource.data.solicitudMercaderiaId.size() > 0
          )
        );
    }

    /** Oficina finanzas: edición de borrador o ajuste pre-aprobación. */
    function compradorActualizaOcBorrador() {
      return isComprador()
        && resource.data.estado in ['BORRADOR', 'PENDIENTE_APROBACION']
        && request.resource.data.estado in ['BORRADOR', 'PENDIENTE_APROBACION'];
    }

    /** Oficina finanzas: enviar OC a bandeja de aprobación. */
    function compradorEnviaOcAprobacion() {
      return isComprador()
        && resource.data.estado == 'BORRADOR'
        && request.resource.data.estado == 'PENDIENTE_APROBACION'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'historialEstados', 'enviadoAprobacionEn', 'enviadoAprobacionPorUid',
          'actualizadoEn'
        ]);
    }

    /** Gerencia: aprobar OC (PENDIENTE_APROBACION → APROBADA). */
    function gerenciaApruebaOrdenCompra() {
      return isGerencia()
        && resource.data.estado == 'PENDIENTE_APROBACION'
        && request.resource.data.estado == 'APROBADA'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'items', 'subtotalNeto', 'montoIva', 'montoPercepciones', 'total',
          'historialEstados', 'aprobadoPorUid', 'aprobadoPorNombre', 'aprobadoEn',
          'recepcionCompleta', 'actualizadoEn'
        ]);
    }

    /** Depósito: recepción física cruzada con OC (registrarRecepcionOcEnIngreso). */
    function depositoActualizaOcRecepcion() {
      return isAdminDeposito()
        && resource.data.estado in ['APROBADA', 'RECIBIDA_PARCIAL']
        && request.resource.data.estado in ['RECIBIDA_PARCIAL', 'COMPLETADA']
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'items', 'movimientosIngresoIds', 'recepcionCompleta',
          'historialEstados', 'actualizadoEn'
        ]);
    }

    /** Oficina finanzas: registrar factura de proveedor contra OC recibida. */
    function financieroActualizaOcPorFactura() {
      return finanzasEscritura()
        && resource.data.estado in ['RECIBIDA_PARCIAL', 'COMPLETADA']
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'facturaCargada', 'deudaGenerada', 'facturasAsociadasIds',
          'montoFacturadoAcumulado', 'actualizadoEn'
        ]);
    }

    function puedeLeerPadronEmpresas() {
      return panelControlLectura() || isAdministrativoCampamento()
        || isAdminDeposito() || finanzasLectura() || isAdminCocina();
    }

    function puedeEscribirPadronEmpresas() {
      return panelControlEscritura() || isAdminDeposito() || finanzasEscritura()
        || liquidacionesEscritura();
    }

    /** Cocina central: alta de clientes de viandas (rol CLIENTE, con CUIT). */
    function altaClienteViandasPadronValida() {
      return isAdminCocina()
        && request.resource.data.keys().hasAll(['nombre', 'cuit', 'creadoEn', 'roles'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.cuit is string
        && request.resource.data.cuit.size() >= 8
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'CLIENTE';
    }

    function actualizacionClienteViandasPadronValida() {
      return isAdminCocina()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['nombre', 'cuit', 'roles'])
        && request.resource.data.nombre is string
        && request.resource.data.cuit is string
        && request.resource.data.cuit.size() >= 8
        && request.resource.data.roles.hasAny(['CLIENTE']);
    }

    /** INGRESO de depósito (incluye recepción vinculada a OC). */
    function creacionIngresoDepositoValido() {
      return isAdminDeposito()
        && request.resource.data.tipo == 'INGRESO'
        && request.resource.data.keys().hasAll([
          'tipo', 'fecha', 'proveedor', 'tipoDocumento', 'numeroDocumento', 'items', 'creadoEn'
        ])
        && request.resource.data.proveedor is string
        && request.resource.data.numeroDocumento is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && (
          !request.resource.data.keys().hasAny(['ordenCompraId'])
          || (
            request.resource.data.ordenCompraId is string
            && request.resource.data.ordenCompraId.size() > 0
            && request.resource.data.keys().hasAny(['ordenCompraNumero'])
            && request.resource.data.ordenCompraNumero is string
          )
        );
    }

    // ─── Módulo B: Tesorería (Cuentas por Pagar) ───────────────────────────

    function puedeLeerTesoreria() {
      return finanzasLectura();
    }

    function estadoFacturaProveedorValido(s) {
      return s == 'PENDIENTE_PAGO' || s == 'PAGO_PARCIAL' || s == 'PAGADA' || s == 'ANULADA';
    }

    function creacionFacturaProveedorValida() {
      return request.resource.data.keys().hasAll([
          'numeroFactura', 'proveedorId', 'proveedorNombre', 'proveedorCuit',
          'ordenCompraId', 'ordenCompraNumero', 'fechaEmision', 'fechaVencimiento',
          'neto', 'montoIva', 'montoPercepciones', 'total', 'saldoPendiente',
          'estado', 'moneda', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'
        ])
        && request.resource.data.estado == 'PENDIENTE_PAGO'
        && request.resource.data.saldoPendiente == request.resource.data.total
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.numeroFactura is string
        && request.resource.data.fechaVencimiento is string
        && request.resource.data.fechaVencimiento.size() == 10
        && estadoFacturaProveedorValido(request.resource.data.estado);
    }

    function financieroActualizaFacturaProveedor() {
      return finanzasEscritura()
        && estadoFacturaProveedorValido(request.resource.data.estado)
        && request.resource.data.estado != 'ANULADA'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'saldoPendiente', 'actualizadoEn'
        ]);
    }

    /** Oficina finanzas: anular factura sin pagos (reverso de deuda). */
    function financieroAnulaFacturaProveedor() {
      return finanzasEscritura()
        && resource.data.estado != 'ANULADA'
        && request.resource.data.estado == 'ANULADA'
        && request.resource.data.saldoPendiente == 0
        && request.resource.data.anuladoPorUid == request.auth.uid
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() > 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'saldoPendiente', 'anuladoPorUid', 'anuladoPorNombre',
          'motivoAnulacion', 'fechaAnulacion', 'actualizadoEn'
        ]);
    }

    /** Oficina finanzas: revertir OC al anular factura. */
    function financieroRevertOcPorAnulacionFactura() {
      return finanzasEscritura()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'facturaCargada', 'deudaGenerada', 'facturasAsociadasIds',
          'montoFacturadoAcumulado', 'actualizadoEn'
        ]);
    }

    /** Depósito: alta de requisición interna de compra. */
    function creacionRequisicionCompraDeposito() {
      return isAdminDeposito()
        && request.resource.data.tipoSolicitud == 'REQUISICION_COMPRA'
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.keys().hasAll([
          'fechaCreacion', 'fechaEntregaEsperada', 'prioridad', 'estado',
          'tipoSolicitud', 'items', 'observacionesDeposito', 'observacionesRecepcion'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
    }

    /** Comprador: vincula requisición interna al emitir OC. */
    function compradorVinculaRequisicionOc() {
      return isComprador()
        && resource.data.tipoSolicitud == 'REQUISICION_COMPRA'
        && resource.data.estado == 'Pendiente'
        && request.resource.data.estado == 'En Compras'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'ordenCompraId', 'ordenCompraNumero', 'actualizadoEn'
        ])
        && request.resource.data.ordenCompraId is string
        && request.resource.data.ordenCompraId.size() > 0
        && request.resource.data.ordenCompraNumero is string;
    }

    // ─── Módulo C: Cuentas por Cobrar (liquidaciones contratistas) ────────

    function puedeLeerLiquidaciones() {
      return liquidacionesLectura();
    }

    function estadoLiquidacionValido(s) {
      return s == 'BORRADOR' || s == 'EMITIDA' || s == 'ANULADA';
    }

    function creacionLiquidacionContratistaValida() {
      return liquidacionesEscritura()
        && request.resource.data.keys().hasAll([
          'numero', 'anio', 'secuencial', 'empresaId', 'empresaNombre', 'empresaCuit',
          'fechaInicio', 'fechaFin', 'totalViandas', 'totalNoches', 'detalles',
          'subtotalNeto', 'montoIva', 'totalFacturado', 'estado',
          'registrosComedorIds', 'historialPernocteIds',
          'creadoPorUid', 'creadoPorNombre', 'creadoEn'
        ])
        && request.resource.data.estado == 'EMITIDA'
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.numero is string
        && request.resource.data.detalles is list
        && request.resource.data.registrosComedorIds is list
        && request.resource.data.historialPernocteIds is list
        && estadoLiquidacionValido(request.resource.data.estado);
    }

    function financieroAnulaLiquidacionContratista() {
      return liquidacionesEscritura()
        && resource.data.estado == 'EMITIDA'
        && request.resource.data.estado == 'ANULADA'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'actualizadoEn', 'anuladoPorUid', 'anuladoEn', 'motivoAnulacion'
        ]);
    }

    /** Marca consumos incluidos en una liquidación EMITIDA (batch billing). */
    function financieroMarcaConsumoLiquidado() {
      return liquidacionesEscritura()
        && resource.data.liquidado != true
        && request.resource.data.liquidado == true
        && request.resource.data.liquidacionId is string
        && request.resource.data.liquidacionId.size() > 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'liquidado', 'liquidacionId'
        ]);
    }

    /** Revierte bloqueo de consumos al anular liquidación. */
    function financieroDesmarcaConsumoLiquidado() {
      return liquidacionesEscritura()
        && resource.data.liquidado == true
        && request.resource.data.liquidado == false
        && !request.resource.data.keys().hasAny(['liquidacionId'])
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'liquidado', 'liquidacionId'
        ]);
    }

    function creacionClaveFacturaProveedorValida() {
      return request.resource.data.keys().hasAll([
          'proveedorId', 'numeroFactura', 'facturaId', 'ordenCompraId', 'anulada', 'creadoEn'
        ])
        && request.resource.data.anulada == false
        && request.resource.data.facturaId is string
        && request.resource.data.proveedorId is string
        && request.resource.data.numeroFactura is string;
    }

    function metodoPagoValido(m) {
      return m == 'TRANSFERENCIA' || m == 'CHEQUE' || m == 'EFECTIVO';
    }

    function estadoOrdenPagoValido(s) {
      return s == 'EMITIDA' || s == 'ANULADA';
    }

    function creacionOrdenPagoValida() {
      return request.resource.data.keys().hasAll([
          'numero', 'anio', 'secuencial', 'proveedorId', 'proveedorNombre',
          'fechaPago', 'montoTotal', 'metodoPago', 'referenciaPago',
          'facturasAplicadas', 'estado', 'creadoPorUid', 'creadoPorNombre',
          'creadoEn', 'actualizadoEn'
        ])
        && request.resource.data.estado == 'EMITIDA'
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.montoTotal is number
        && request.resource.data.montoTotal > 0
        && request.resource.data.facturasAplicadas is list
        && request.resource.data.facturasAplicadas.size() > 0
        && metodoPagoValido(request.resource.data.metodoPago)
        && estadoOrdenPagoValido(request.resource.data.estado)
        && request.resource.data.referenciaPago is string
        && request.resource.data.referenciaPago.size() > 0;
    }

    /** Oficina finanzas: anular OP y registrar auditoría. */
    function financieroAnulaOrdenPago() {
      return finanzasEscritura()
        && resource.data.estado == 'EMITIDA'
        && request.resource.data.estado == 'ANULADA'
        && request.resource.data.anuladoPorUid == request.auth.uid
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() > 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado', 'anuladoPorUid', 'anuladoPorNombre', 'motivoAnulacion',
          'fechaAnulacion', 'actualizadoEn'
        ]);
    }

    function puedeLeerContadorOp() {
      return finanzasLectura();
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /menu/{itemId} {
      allow read: if signedIn();
      allow create, delete: if isAdminCocina() || isNutricion() || panelControlEscritura();
      allow update: if isAdminCocina() || isNutricion() || panelControlEscritura()
        || (menuComprometeStockPedido() && isClientePedido())
        || (menuSoloDescuentaStock() && isClientePedido());
    }

    match /pedidos/{pedidoId} {
      allow read: if signedIn() && (isAdminCocina() || isNutricion() || isAnalista() || isGerencia());
      allow create: if pedidoClienteValido() && isClientePedido();
      allow update: if isAdminCocina();
      allow delete: if isAdminCocina();
    }

    match /planificacion_menu_empresa/{planId} {
      allow read: if signedIn() && (
        isAdminCocina() || isNutricion() || isAnalista() || isGerencia()
        || resource.data.estado == 'PUBLICADA'
      );
      allow create, update, delete: if isAdminCocina();
    }

    match /insumos/{insumoId} {
      allow read: if signedIn() && staffLeerInsumos();
      allow create, update, delete: if isAdminDeposito();
    }

    match /categorias/{catId} {
      allow read: if signedIn() && staffLeerInsumos();
      allow create, update, delete: if isAdminDeposito();
    }

    match /recetario/{docId} {
      allow read: if signedIn() && (isAdminCocina() || isNutricion() || isAdminDeposito() || isAnalista() || isGerencia());
      allow create, update, delete: if isNutricion();
    }

    match /solicitudes_mercaderia/{id} {
      allow read: if signedIn() && (isAdminCocina() || isAdminDeposito() || isAdministrativoCampamento() || isAnalista() || isGerencia() || isAdministrativoFinanzas() || isAdministrativoLiquidaciones());
      allow create: if signedIn() && (
        isAdminCocina() || isAdministrativoCampamento()
        || creacionRequisicionCompraDeposito()
      );
      allow update: if signedIn() && (
        isAdminCocina() || isAdminDeposito() || isAdministrativoCampamento()
        || compradorVinculaRequisicionOc()
      );
      allow delete: if isAdminDeposito();
    }

    match /movimientos_inventario/{movId} {
      allow read: if signedIn() && puedeLeerMovimientos();
      allow create: if signedIn() && (
        creacionIngresoDepositoValido()
        || (puedeCrearMovimiento() && !(isAdminDeposito() && request.resource.data.tipo == 'INGRESO'))
      );
      allow update: if signedIn() && (
          isAdminDeposito()
          || (
            receptorPuedeCerrarRecepcionEgreso()
            && (
              (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(['estadoTraslado', 'recibidoEn'])
                && request.resource.data.estadoTraslado == 'RECIBIDO'
              )
              || (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(['estadoTraslado', 'rechazadoEn', 'motivoRechazo'])
                && request.resource.data.estadoTraslado == 'RECHAZADO'
                && request.resource.data.motivoRechazo is string
                && request.resource.data.motivoRechazo.size() > 0
              )
            )
          )
        );
      allow delete: if signedIn() && isAdminDeposito();
    }

    match /saldo_lotes/{docId} {
      allow read: if signedIn() && puedeLeerMovimientos();
      allow create, update: if signedIn() && (puedeEscribirSaldoLote() || receptorRestauraSaldoDepositoEnRechazo());
      allow delete: if signedIn() && isAdminDeposito();
    }

    match /produccion_cocina/{id} {
      allow read: if signedIn() && (isAnalista() || isGerencia() || isAdminDeposito() || isAdminCocina() || isNutricion());
      allow create: if signedIn() && isAdminCocina()
        && request.resource.data.keys().hasAll([
          'fecha', 'ubicacionId', 'recetaId', 'recetaNombre', 'cantidadPorciones',
          'insumoProductoId', 'nombreProducto', 'costoTeorico', 'costoReal',
          'desvioPorcentaje', 'egresoId', 'ingresoId'
        ])
        && request.resource.data.ubicacionId == cocinaUbicacionUsuario();
      allow update, delete: if false;
    }

    match /despachos_viandas/{id} {
      allow read: if signedIn() && (isAdminCocina() || isAnalista() || isGerencia() || isNutricion());
      allow create: if signedIn() && isAdminCocina()
        && request.resource.data.keys().hasAll([
          'fecha', 'empresa', 'numeroRemito', 'items', 'creadoEn'
        ])
        && request.resource.data.empresa is string
        && request.resource.data.empresa.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update, delete: if false;
    }

    match /padron_personas/{id} {
      allow read: if signedIn() && (panelControlLectura() || isAdministrativoCampamento() || isControlComedor());
      allow create, update, delete: if signedIn() && panelControlEscritura();
    }

    match /padron_empresas/{id} {
      allow read: if signedIn() && puedeLeerPadronEmpresas();
      allow create: if signedIn() && (
        puedeEscribirPadronEmpresas() || altaClienteViandasPadronValida()
      );
      allow update: if signedIn() && (
        puedeEscribirPadronEmpresas() || actualizacionClienteViandasPadronValida()
      );
      allow delete: if signedIn() && puedeEscribirPadronEmpresas();
    }

    match /registros_comedor/{id} {
      allow read: if signedIn() && (panelControlLectura() || isAdministrativoCampamento() || isControlComedor());
      allow create: if signedIn() && (
        creacionRegistroComedorTerminal() || creacionRegistroComedorSupervisor()
      );
      allow update: if signedIn() && (
        financieroMarcaConsumoLiquidado() || financieroDesmarcaConsumoLiquidado()
      );
      allow delete: if false;
    }

    match /camas/{id} {
      allow read: if signedIn() && panelControlLectura();
      allow create, update, delete: if signedIn() && panelControlEscritura();
    }

    match /historial_limpiezas/{id} {
      allow read: if signedIn() && panelControlLectura();
      allow create: if signedIn() && panelControlEscritura();
      allow update, delete: if false;
    }

    match /historial_pernoctes/{id} {
      allow read: if signedIn() && panelControlLectura();
      allow create, delete: if signedIn() && panelControlEscritura();
      allow update: if signedIn() && (
        panelControlEscritura()
        || financieroMarcaConsumoLiquidado() || financieroDesmarcaConsumoLiquidado()
      );
    }

    // ─── Módulo A: Compras ─────────────────────────────────────────────────

    match /contadores/{contadorId} {
      allow read: if signedIn() && (
        (contadorId == 'numeracion_oc' && (finanzasLectura() || isAdminDeposito()))
        || (contadorId == 'numeracion_op' && puedeLeerContadorOp())
        || (contadorId == 'numeracion_liq' && puedeLeerLiquidaciones())
      );
      allow create, update: if signedIn() && (
        (contadorId == 'numeracion_oc' && isComprador())
        || (contadorId == 'numeracion_op' && finanzasEscritura())
        || (contadorId == 'numeracion_liq' && liquidacionesEscritura())
      );
      allow delete: if false;
    }

    match /ordenes_compra/{ocId} {
      allow read: if signedIn() && puedeLeerCompras();
      allow create: if signedIn() && isComprador() && creacionOrdenCompraValida();
      allow update: if signedIn() && (
        compradorActualizaOcBorrador()
        || compradorEnviaOcAprobacion()
        || gerenciaApruebaOrdenCompra()
        || depositoActualizaOcRecepcion()
        || financieroActualizaOcPorFactura()
        || financieroRevertOcPorAnulacionFactura()
      );
      allow delete: if false;
    }

    // ─── Módulo B: Tesorería ───────────────────────────────────────────────

    match /facturas_proveedores/{facturaId} {
      allow read: if signedIn() && puedeLeerTesoreria();
      allow create: if signedIn() && finanzasEscritura() && creacionFacturaProveedorValida();
      allow update: if signedIn() && (
        financieroActualizaFacturaProveedor()
        || financieroAnulaFacturaProveedor()
      );
      allow delete: if false;
    }

    match /facturas_proveedores_claves/{claveId} {
      allow read: if signedIn() && finanzasEscritura();
      allow create: if signedIn() && finanzasEscritura() && creacionClaveFacturaProveedorValida();
      allow delete: if signedIn() && finanzasEscritura();
      allow update: if false;
    }

    match /ordenes_pago/{opId} {
      allow read: if signedIn() && puedeLeerTesoreria();
      allow create: if signedIn() && finanzasEscritura() && creacionOrdenPagoValida();
      allow update: if signedIn() && financieroAnulaOrdenPago();
      allow delete: if false;
    }

    // ─── Expediente digital: documentos adjuntos ───────────────────────────

    function tipoEntidadDocumentoValido(t) {
      return t == 'ORDEN_COMPRA' || t == 'FACTURA_PROVEEDOR' || t == 'ORDEN_PAGO' || t == 'PROVEEDOR';
    }

    function tipoComprobanteDocumentoValido(t) {
      return t == 'FACTURA' || t == 'REMITO' || t == 'COMPROBANTE_PAGO' || t == 'LISTA_PRECIOS' || t == 'OTRO';
    }

    function camposOpcionalesDocumentoAdjuntoOk() {
      return (
        !request.resource.data.keys().hasAny(['ordenCompraId'])
        || (
          request.resource.data.ordenCompraId is string
          && request.resource.data.ordenCompraId.size() > 0
        )
      ) && (
        !request.resource.data.keys().hasAny(['proveedorId'])
        || (
          request.resource.data.proveedorId is string
          && request.resource.data.proveedorId.size() > 0
        )
      ) && (
        !request.resource.data.keys().hasAny(['subidoPorNombre'])
        || (
          request.resource.data.subidoPorNombre is string
          && request.resource.data.subidoPorNombre.size() > 0
        )
      );
    }

    function creacionDocumentoAdjuntoValida() {
      return request.resource.data.keys().hasAll([
          'entidadId', 'entidadTipo', 'tipoComprobante', 'url', 'nombreArchivo',
          'subidoPorUid', 'fechaSubida'
        ])
        && request.resource.data.entidadId is string
        && request.resource.data.entidadId.size() > 0
        && tipoEntidadDocumentoValido(request.resource.data.entidadTipo)
        && tipoComprobanteDocumentoValido(request.resource.data.tipoComprobante)
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.nombreArchivo is string
        && request.resource.data.nombreArchivo.size() > 0
        && request.resource.data.subidoPorUid == request.auth.uid
        && camposOpcionalesDocumentoAdjuntoOk();
    }

    /** Depósito: foto/PDF del remito o factura al confirmar ingreso contra OC. */
    function depositoSubeComprobanteOc() {
      return isAdminDeposito()
        && creacionDocumentoAdjuntoValida()
        && request.resource.data.entidadTipo == 'ORDEN_COMPRA'
        && request.resource.data.tipoComprobante in ['REMITO', 'FACTURA']
        && request.resource.data.keys().hasAny(['ordenCompraId', 'proveedorId'])
        && request.resource.data.ordenCompraId == request.resource.data.entidadId;
    }

    function financieroActualizaDocumentoAdjunto() {
      return finanzasEscritura()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'tipoComprobante', 'url', 'nombreArchivo', 'mimeType', 'tamanoBytes'
        ])
        && tipoComprobanteDocumentoValido(request.resource.data.tipoComprobante);
    }

    match /documentos_adjuntos/{docId} {
      allow read: if signedIn() && (finanzasLectura() || isAdminDeposito());
      allow create: if signedIn() && (
        (finanzasEscritura() && creacionDocumentoAdjuntoValida())
        || depositoSubeComprobanteOc()
      );
      allow update: if signedIn() && financieroActualizaDocumentoAdjunto();
      allow delete: if signedIn() && finanzasEscritura();
    }

    // ─── Módulo C: Liquidaciones contratistas ──────────────────────────────

    match /liquidaciones_contratistas/{liqId} {
      allow read: if signedIn() && puedeLeerLiquidaciones();
      allow create: if signedIn() && creacionLiquidacionContratistaValida();
      allow update: if signedIn() && financieroAnulaLiquidacionContratista();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
