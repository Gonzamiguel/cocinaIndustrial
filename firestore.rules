rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function userDocExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function userData() {
      return get(userPath(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userData().rol : null;
    }

    function hasRole(r) {
      return userRole() == r;
    }

    function isAdminCocina() {
      return hasRole('admin_cocina');
    }

    function isAdminDeposito() {
      return hasRole('admin_deposito');
    }

    function isAdminCampamento() {
      return hasRole('admin_campamento');
    }

    function isAnalista() {
      return hasRole('analista');
    }

    function isGerencia() {
      return hasRole('gerencia');
    }

    function isJefeCampamento() {
      return hasRole('jefe_campamento');
    }

    /** Lectura transversal de datos operativos (sin silo por ubicación en la app). */
    function visionGlobalLectura() {
      return isAnalista() || isGerencia();
    }

    /** Panel MVP `/control`: comensales, hotelería y menú (lectura). */
    function panelControlLectura() {
      return isAdminCampamento() || isHoteleriaCasposo() || isGerencia() || isAnalista();
    }

    /** Escritura operativa en `/control` (sin rol analista, solo lectura global). */
    function panelControlEscritura() {
      return isAdminCampamento() || isHoteleriaCasposo() || isGerencia();
    }

    /** Hotelería / campamento: mismo literal que en `AuthContext` y en el documento `usuarios/{uid}`. */
    function isHoteleriaCasposo() {
      return hasRole('hoteleria_casposo');
    }

    /** Terminal de comensales (modo quiosco en acceso al comedor). */
    function isTerminalComedor() {
      return hasRole('terminal_comedor');
    }

    /** Proveedor de autenticación Firebase (p. ej. `anonymous`, `password`). */
    function authSignInProvider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    /** Vista pública de pedidos (`signInAnonymously` en `authPublico.ts`). */
    function isAuthAnonimo() {
      return signedIn() && authSignInProvider() == 'anonymous';
    }

    /**
     * Quien puede crear pedidos o descontar stock del menú en transacción:
     * cliente anónimo o terminal de comedor con documento en `usuarios`.
     */
    function isClientePedido() {
      return isAuthAnonimo() || isTerminalComedor();
    }

    function servicioComedorValido(s) {
      return s == 'DESAYUNO' || s == 'ALMUERZO' || s == 'MERIENDA' || s == 'CENA'
        || s == 'CENA_NOCHERO' || s == 'FUERA DE HORARIO';
    }

    /** Carga retroactiva desde dashboard: no admite fuera de horario. */
    function servicioComedorRetroManualValido(s) {
      return s == 'DESAYUNO' || s == 'ALMUERZO' || s == 'MERIENDA' || s == 'CENA' || s == 'CENA_NOCHERO';
    }

    function fechaHoraRegistroComedorOk() {
      return request.resource.data.fechaHora is timestamp
        || request.resource.data.fechaHora == request.time;
    }

    function contieneRefrigerioRegistroComedorOk() {
      return !request.resource.data.keys().hasAny(['contieneRefrigerio'])
        || request.resource.data.contieneRefrigerio is bool;
    }

    function observacionesRegistroComedorOpcionalOk() {
      return !request.resource.data.keys().hasAny(['observaciones'])
        || (
          request.resource.data.observaciones is string
          && request.resource.data.observaciones.size() > 0
          && request.resource.data.observaciones.size() <= 2000
        );
    }

    function creacionRegistroComedorTerminal() {
      return isTerminalComedor()
        && request.resource.data.keys().hasAll([
          'dni', 'nombre', 'apellido', 'empresa', 'servicio', 'diaOperativo', 'fechaHora', 'usuarioRegistro'
        ])
        && request.resource.data.dni is string
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string
        && request.resource.data.empresa is string
        && request.resource.data.diaOperativo is string
        && request.resource.data.diaOperativo.size() == 10
        && request.resource.data.usuarioRegistro is string
        && request.resource.data.usuarioRegistro == request.auth.uid
        && servicioComedorValido(request.resource.data.servicio)
        && fechaHoraRegistroComedorOk()
        && contieneRefrigerioRegistroComedorOk()
        && observacionesRegistroComedorOpcionalOk();
    }

    function creacionRegistroComedorSupervisor() {
      return (panelControlEscritura() || isJefeCampamento())
        && request.resource.data.keys().hasAll([
          'dni', 'nombre', 'apellido', 'empresa', 'servicio', 'diaOperativo', 'fechaHora', 'usuarioRegistro',
          'observaciones'
        ])
        && request.resource.data.dni is string
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string
        && request.resource.data.empresa is string
        && request.resource.data.diaOperativo is string
        && request.resource.data.diaOperativo.size() == 10
        && request.resource.data.usuarioRegistro == 'Carga Manual Supervisor'
        && request.resource.data.observaciones is string
        && request.resource.data.observaciones.size() > 0
        && request.resource.data.observaciones.size() <= 2000
        && servicioComedorRetroManualValido(request.resource.data.servicio)
        && fechaHoraRegistroComedorOk()
        && contieneRefrigerioRegistroComedorOk();
    }

    /** Staff con documento en `usuarios` (excluye solo anónimos sin rol). */
    function staffLeerInsumos() {
      return isAdminDeposito() || isAnalista() || isGerencia() || isAdminCampamento() || isJefeCampamento() || isAdminCocina();
    }

    function puedeLeerMovimientos() {
      return isAdminDeposito() || isAnalista() || isGerencia() || isAdminCampamento() || isJefeCampamento() || isAdminCocina();
    }

    /** Ubicación operativa del usuario campamento (fallback Casposo si no está en el doc). */
    function campamentoUbicacionUsuario() {
      return (userDocExists() &&
        userData().keys().hasAny(['ubicacionId']) &&
        userData().ubicacionId is string &&
        userData().ubicacionId != '')
        ? userData().ubicacionId
        : 'CASPOSO';
    }

    /** Campamento o jefe de campamento: solo documentos cuya ubicación coincide con la del usuario. */
    function campamentoUbicacionCoincide() {
      return (isAdminCampamento() || isJefeCampamento())
        && request.resource.data.keys().hasAny(['ubicacionId'])
        && request.resource.data.ubicacionId == campamentoUbicacionUsuario();
    }

    /** Ubicación cocina central (fallback COCINA si no está en el doc). */
    function cocinaUbicacionUsuario() {
      return (userDocExists() &&
        userData().keys().hasAny(['ubicacionId']) &&
        userData().ubicacionId is string &&
        userData().ubicacionId != '')
        ? userData().ubicacionId
        : 'COCINA';
    }

    /** Cocina: movimientos e ingresos solo en su ubicación operativa. */
    function cocinaUbicacionCoincide() {
      return isAdminCocina()
        && request.resource.data.keys().hasAny(['ubicacionId'])
        && request.resource.data.ubicacionId == cocinaUbicacionUsuario();
    }

    function puedeCrearMovimiento() {
      return isAdminDeposito() || campamentoUbicacionCoincide() || cocinaUbicacionCoincide();
    }

    function puedeEscribirSaldoLote() {
      return isAdminDeposito() || campamentoUbicacionCoincide() || cocinaUbicacionCoincide();
    }

    /** Recepción en sucursal o cocina: cerrar egreso EN_TRANSITO destinado a esta ubicación. */
    function receptorPuedeCerrarRecepcionEgreso() {
      return resource.data.tipo == 'EGRESO'
        && resource.data.estadoTraslado == 'EN_TRANSITO'
        && resource.data.keys().hasAny(['ubicacionDestino'])
        && (
          ((isAdminCampamento() || isJefeCampamento()) && resource.data.ubicacionDestino == campamentoUbicacionUsuario())
          || (isAdminCocina() && resource.data.ubicacionDestino == cocinaUbicacionUsuario())
        );
    }

    /** Pedido público (cliente anónimo o staff): creación con campos mínimos. */
    function pedidoClienteValido() {
      return request.resource.data.keys().hasAll(['nombreCliente', 'lugarEntrega'])
        && request.resource.data.nombreCliente is string
        && request.resource.data.lugarEntrega is string
        && (
          !request.resource.data.keys().hasAny(['fechaConsumo'])
          || request.resource.data.fechaConsumo is string
        );
    }

    /** Descuento de stock del menú: solo baja estricta de `stock`. */
    function menuSoloDescuentaStock() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /menu/{itemId} {
      allow read: if signedIn();
      allow create, delete: if isAdminCocina() || panelControlEscritura();
      allow update: if isAdminCocina() || panelControlEscritura()
        || (menuSoloDescuentaStock() && isClientePedido());
    }

    match /pedidos/{pedidoId} {
      allow read: if signedIn() && (isAdminCocina() || isAnalista() || isGerencia());
      allow create: if pedidoClienteValido() && isClientePedido();
      allow update: if isAdminCocina();
      allow delete: if isAdminCocina();
    }

    match /insumos/{insumoId} {
      allow read: if signedIn() && staffLeerInsumos();
      allow create, update, delete: if isAdminDeposito();
    }

    match /categorias/{catId} {
      allow read: if signedIn() && staffLeerInsumos();
      allow create, update, delete: if isAdminDeposito();
    }

    match /recetario/{docId} {
      allow read: if signedIn() && (isAdminCocina() || isAdminDeposito() || isAnalista() || isGerencia());
      allow create, update, delete: if isAdminCocina();
    }

    match /solicitudes_mercaderia/{id} {
      allow read: if signedIn() && (isAdminCocina() || isAdminDeposito() || isAdminCampamento() || isJefeCampamento() || isAnalista() || isGerencia());
      allow create: if isAdminCocina() || isAdminCampamento() || isJefeCampamento();
      allow update: if isAdminCocina() || isAdminDeposito() || isAdminCampamento() || isJefeCampamento();
      allow delete: if isAdminDeposito();
    }

    match /movimientos_inventario/{movId} {
      allow read: if signedIn() && puedeLeerMovimientos();
      allow create: if signedIn() && puedeCrearMovimiento();
      allow update: if signedIn() && (
          isAdminDeposito()
          || (
            receptorPuedeCerrarRecepcionEgreso()
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['estadoTraslado', 'recibidoEn'])
            && request.resource.data.estadoTraslado == 'RECIBIDO'
          )
        );
      allow delete: if signedIn() && isAdminDeposito();
    }

    match /saldo_lotes/{docId} {
      allow read: if signedIn() && puedeLeerMovimientos();
      allow create, update: if signedIn() && puedeEscribirSaldoLote();
      allow delete: if signedIn() && isAdminDeposito();
    }

    match /produccion_cocina/{id} {
      allow read: if signedIn() && (isAnalista() || isGerencia() || isAdminDeposito() || isAdminCocina());
      allow create: if signedIn() && isAdminCocina()
        && request.resource.data.keys().hasAll([
          'fecha', 'ubicacionId', 'recetaId', 'recetaNombre', 'cantidadPorciones',
          'insumoProductoId', 'nombreProducto', 'costoTeorico', 'costoReal',
          'desvioPorcentaje', 'egresoId', 'ingresoId'
        ])
        && request.resource.data.ubicacionId == cocinaUbicacionUsuario();
      allow update, delete: if false;
    }

    match /padron_personas/{id} {
      allow read: if signedIn() && (panelControlLectura() || isTerminalComedor() || isJefeCampamento());
      allow create, update, delete: if signedIn() && (panelControlEscritura() || isJefeCampamento());
    }

    match /padron_empresas/{id} {
      allow read: if signedIn() && (panelControlLectura() || isTerminalComedor() || isJefeCampamento());
      allow create, update, delete: if signedIn() && (panelControlEscritura() || isJefeCampamento());
    }

    match /registros_comedor/{id} {
      allow read: if signedIn() && (panelControlLectura() || isTerminalComedor() || isJefeCampamento());
      allow create: if signedIn() && (
        creacionRegistroComedorTerminal() || creacionRegistroComedorSupervisor()
      );
      allow update, delete: if false;
    }

    match /camas/{id} {
      allow read: if signedIn() && (panelControlLectura() || isJefeCampamento());
      allow create, update, delete: if signedIn() && (panelControlEscritura() || isJefeCampamento());
    }

    match /historial_limpiezas/{id} {
      allow read: if signedIn() && (panelControlLectura() || isJefeCampamento());
      allow create: if signedIn() && (panelControlEscritura() || isJefeCampamento());
      allow update, delete: if false;
    }

    match /historial_pernoctes/{id} {
      allow read: if signedIn() && (panelControlLectura() || isJefeCampamento());
      allow create, update, delete: if signedIn() && (panelControlEscritura() || isJefeCampamento());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
